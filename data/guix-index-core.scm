;;; Read-only package-object extraction. Loading this file does not scan Guix.
(use-modules (guix packages) (guix diagnostics) (guix licenses) (guix gexp)
             (json) (srfi srfi-1))

;; Slots: packages, typed references, catalog membership, diagnostics box.
;; Names and source locations are labels, not object identities.
(define (collect-package-graph seeds progress)
  (let ((ids (make-hash-table 40000)) (catalog (make-hash-table 40000))
        (objects (make-hash-table 40000)) (edges (make-hash-table 40000))
        (front '()) (back '()) (next-id 0) (diagnostics (list '())))
    (define (diagnose! id kind code message)
      (set-car! diagnostics
                (cons `(("package_id" . ,id) ("kind" . ,kind)
                        ("code" . ,code) ("message" . ,message))
                      (car diagnostics))))
    (define (intern! p)
      (or (hashq-ref ids p #f)
          (begin
            (when (>= next-id 1000000) (error "package graph exceeds safety limit"))
            (let ((id next-id))
              (set! next-id (+ next-id 1))
              (hashq-set! ids p id)
              (hash-set! objects id p)
              (set! back (cons p back))
              id))))
    (define (references p id kind accessor)
      ;; Catch accessor failures, but never downgrade structural safety limits.
      (let ((value (catch #t (lambda () (cons #t (accessor p)))
                    (lambda _ (diagnose! id kind "accessor-failed"
                                         "Could not read declared inputs")
                              (cons #f '())))))
        (define (unknown!)
          (diagnose! id kind "unsupported-input" "Unrecognized or cyclic input shape"))
        (define (walk x depth ancestors nested?)
          (cond
           ((package? x) (list (intern! x)))
           ((or (origin? x) (gexp? x) (file-like? x) (null? x)) '())
           ((and nested? (string? x)) '()) ; tuple label/output
           ((pair? x)
            (if (or (>= depth 64) (memq x ancestors))
                (begin (unknown!) '())
                (let ((path (cons x ancestors)))
                  (append (walk (car x) (+ depth 1) path #t)
                          (walk (cdr x) (+ depth 1) path #t)))))
           (else (unknown!) '())))
        (if (not (car value)) '()
            (let ((seen (make-hash-table)) (pairs (make-hash-table)))
              (let loop ((xs (cdr value)) (out '()) (count 0))
                (cond
                 ((null? xs) (reverse out))
                 ((or (not (pair? xs)) (hashq-ref pairs xs #f))
                  (unknown!) (reverse out))
                 (else
                  (hashq-set! pairs xs #t)
                  (when (>= count 100000) (error "input list exceeds safety limit"))
                  (let ((found (walk (car xs) 0 '() #f)))
                    (loop (cdr xs)
                          (fold (lambda (dep acc)
                                  (if (hashv-ref seen dep #f) acc
                                      (begin (hashv-set! seen dep #t) (cons dep acc))))
                                out found)
                          (+ count 1))))))))))
    (for-each (lambda (p) (hashq-set! catalog p #t) (intern! p)) seeds)
    (let loop ((processed 0))
      (when (null? front) (set! front (reverse back)) (set! back '()))
      (unless (null? front)
        (let* ((p (car front)) (id (hashq-ref ids p)))
          (set! front (cdr front))
          (hash-set! edges id
                     (vector (references p id "input" package-inputs)
                             (references p id "propagated" package-propagated-inputs)
                             (references p id "native" package-native-inputs)))
          (when (zero? (modulo (+ processed 1) 500)) (progress (+ processed 1) next-id))
          (loop (+ processed 1)))))
    (vector (list->vector (map (lambda (id) (hash-ref objects id)) (iota next-id)))
            (list->vector (map (lambda (id) (hash-ref edges id)) (iota next-id)))
            catalog diagnostics)))

(define (index-clean-text s)
  (list->string
   (filter (lambda (c) (or (memv c '(#\newline #\tab))
                           (and (>= (char->integer c) 32)
                                (not (<= 127 (char->integer c) 159)))))
           (string->list s))))

(define (write-index graph commit generated-ms out err)
  (let* ((packages (vector-ref graph 0)) (refs (vector-ref graph 1))
         (catalog (vector-ref graph 2)) (diagnostics (vector-ref graph 3))
         (total (vector-length packages)))
    (define (safe id field thunk fallback)
      (catch #t thunk
        (lambda _
          (set-car! diagnostics
                    (cons `(("package_id" . ,id) ("kind" . "metadata")
                            ("code" . "metadata-failed")
                            ("message" . ,(string-append "Could not read " field)))
                          (car diagnostics)))
          fallback)))
    (define (text id field thunk)
      (safe id field (lambda () (let ((v (thunk)))
                                 (if (string? v) (index-clean-text v)
                                     (if (not v) "" (error "not a string"))))) ""))
    (display "{\"header\":" out)
    (scm->json `(("schema" . 4) ("guix_commit" . ,commit)
                ("generated_ms" . ,generated-ms) ("package_count" . ,total)) out)
    (display ",\"packages\":[" out)
    (do ((id 0 (+ id 1))) ((= id total))
      (let* ((p (vector-ref packages id)) (r (vector-ref refs id))
             (licenses (safe id "licenses"
                         (lambda ()
                           (let ((l (package-license p)))
                             (map (lambda (x) (index-clean-text (license-name x)))
                                  (filter license? (if (list? l) l (list l)))))) '()))
             (location (safe id "location"
                         (lambda () (let ((l (package-location p)))
                                      (if l (vector (index-clean-text (location-file l))
                                                    (location-line l)) '#("" 0))))
                         '#("" 0))))
        (unless (zero? id) (display "," out))
        (scm->json
         `(("id" . ,id) ("catalog" . ,(and (hashq-ref catalog p #f) #t))
           ("name" . ,(text id "name" (lambda () (package-name p))))
           ("version" . ,(text id "version" (lambda () (package-version p))))
           ("synopsis" . ,(text id "synopsis" (lambda () (package-synopsis p))))
           ("description" . ,(text id "description" (lambda () (package-description p))))
           ("homepage" . ,(text id "homepage" (lambda () (package-home-page p))))
           ("licenses" . ,(list->vector licenses)) ("file" . ,location)
           ("inputs" . ,(list->vector (vector-ref r 0)))
           ("propagated_inputs" . ,(list->vector (vector-ref r 1)))
           ("native_inputs" . ,(list->vector (vector-ref r 2)))) out)
        (when (or (zero? (modulo (+ id 1) 500)) (= (+ id 1) total))
          (format err "PROGRESS ~a ~a~%" (+ id 1) total) (force-output err))))
    (display "],\"diagnostics\":" out)
    (scm->json (list->vector (reverse (car diagnostics))) out)
    (display "}\n" out) (force-output out)))
